{
  "name": "stellar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --filter web generate-routes && tsc -p apps/web/tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "test": "pnpm --filter web test",
    "test:e2e": "playwright test",
    "deploy": "./scripts/deploy.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@effect/tsgo": "0.48.0",
    "@playwright/test": "^1.63.0",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
