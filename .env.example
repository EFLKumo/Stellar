# Set the first administrator account.
STELLAR_ADMIN_EMAIL=admin@example.com
STELLAR_ADMIN_USERNAME=admin
# The deploy script generates a password when this field is empty.
STELLAR_ADMIN_PASSWORD=

# Set the site address.
DOMAIN=localhost
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443

# The deploy script generates these secrets when the fields are empty.
# Use hexadecimal characters for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Set a key for each provider in AI_MODELS.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODELS='[{"id":"gemini-flash","name":"Gemini Flash","provider":"google","model":"gemini-flash-latest"}]'

# Set the RSS worker limits.
RSS_POLL_SECONDS=900
RSS_CONCURRENCY=2
